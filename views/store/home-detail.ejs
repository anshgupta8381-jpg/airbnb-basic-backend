<%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/nav') %>

    <main style="max-width: 700px; margin: 40px auto; padding: 0 16px;">

        <div style="background: white; border: 1px solid #ddd; border-radius: 16px; overflow: hidden;">
            
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>"
                style="width: 100%; height: 280px; object-fit: cover;" />

            <div style="padding: 24px;">

                <h2 style="font-size: 22px; font-weight: 700; color: #222; margin-bottom: 8px;">
                    <%= home.houseName %>
                </h2>

                <p style="font-size: 14px; color: #777; margin-bottom: 16px;">
                    📍 <%= home.location %>
                </p>

                <p style="font-size: 18px; font-weight: 700; color: #e03131; margin-bottom: 20px;">
                    ₹<%= home.price %> / night
                </p>

                <div style="background: #f9f9f9; border: 1px solid #eee; border-radius: 10px; padding: 16px; margin-bottom: 24px;">
                    <p style="font-size: 13px; font-weight: 600; color: #aaa; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Description</p>
                    <p style="font-size: 14px; color: #bbb; font-style: italic;">No description available yet.</p>
                </div>

                <div style="display: flex; gap: 10px;">
                    <a href="/book/<%= home.id %>"
                        style="flex: 1; display: block; text-align: center; padding: 12px; background: #e03131; color: white; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 500;">
                        Book Now
                    </a>

                   <%- include('../partials/favourite') %>
                </div>

            </div>
        </div>

    </main>
</body>
</html>